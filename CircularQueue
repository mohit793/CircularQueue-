import java.util.Scanner;

public class CircularQueue {

    static int MAX = 5;
    static int[] queue = new int[MAX];
    static int front = -1;
    static int rear = -1;

    // Enqueue operation
    static void enqueue(int job) {
        if ((rear + 1) % MAX == front) {
            System.out.println("Queue Overflow! Queue is full.");
        } else {
            if (front == -1) {
                front = 0;
            }

            rear = (rear + 1) % MAX;
            queue[rear] = job;

            System.out.println("Print job " + job + " added.");
        }
    }

    // Dequeue operation
    static void dequeue() {
        if (front == -1) {
            System.out.println("Queue Underflow! Queue is empty.");
        } else {
            System.out.println("Print job " + queue[front] + " completed.");

            if (front == rear) {
                front = -1;
                rear = -1;
            } else {
                front = (front + 1) % MAX;
            }
        }
    }

    // Peek operation
    static void peek() {
        if (front == -1) {
            System.out.println("Queue is empty.");
        } else {
            System.out.println("Next print job: " + queue[front]);
        }
    }

    // Display operation
    static void display() {
        if (front == -1) {
            System.out.println("Queue is empty.");
        } else {
            System.out.println("Print jobs in queue:");

            int i = front;

            while (true) {
                System.out.print(queue[i] + " ");

                if (i == rear) {
                    break;
                }

                i = (i + 1) % MAX;
            }

            System.out.println();
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int choice;
        int job;

        do {
            System.out.println("\n--- Circular Queue - Printer ---");
            System.out.println("1. Enqueue");
            System.out.println("2. Dequeue");
            System.out.println("3. Peek");
            System.out.println("4. Display");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    System.out.print("Enter print job number: ");
                    job = sc.nextInt();
                    enqueue(job);
                    break;

                case 2:
                    dequeue();
                    break;

                case 3:
                    peek();
                    break;

                case 4:
                    display();
                    break;

                case 5:
                    System.out.println("Program ended.");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 5);

        sc.close();
    }
}
